#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#define UPDOWN_STYLE UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS
#define DROPDOWN_STYLE CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

IDD_SETTINGS DIALOGEX 0, 0, 380, 367
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Overlay Indicator"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Sized for the longest translation in data/locale. After changing text, run:
    //   overlay-demo --dialog --check-layout --locale data\locale\<lang>.ini
    AUTOCHECKBOX    "&Enable the on-screen overlay", IDC_ENABLED, 10, 7, 300, 10

    GROUPBOX        "Status indicator", IDC_GRP_INDICATOR, 7, 22, 366, 99
    AUTOCHECKBOX    "Show status &indicator", IDC_IND_SHOW, 15, 35, 180, 10
    RTEXT           "Position:", IDC_IND_CORNER_LABEL, 200, 36, 78, 8
    COMBOBOX        IDC_IND_CORNER, 282, 33, 84, 80, DROPDOWN_STYLE
    LTEXT           "Show icons for:", IDC_IND_LABEL_ICONS, 15, 52, 64, 8
    AUTOCHECKBOX    "Recording", IDC_IND_REC, 82, 51, 62, 10
    AUTOCHECKBOX    "Streaming", IDC_IND_STREAM, 146, 51, 54, 10
    AUTOCHECKBOX    "Replay buffer", IDC_IND_REPLAY, 202, 51, 78, 10
    AUTOCHECKBOX    "Virtual camera", IDC_IND_VCAM, 282, 51, 84, 10
    AUTOCHECKBOX    "Show elapsed &time next to recording and streaming", IDC_IND_TIMER, 15, 66, 350, 10
    LTEXT           "Microphone:", IDC_MIC_LABEL, 15, 83, 64, 8
    COMBOBOX        IDC_MIC_MODE, 82, 80, 100, 60, DROPDOWN_STYLE
    RTEXT           "Source:", IDC_MIC_SOURCE_LABEL, 186, 83, 50, 8
    COMBOBOX        IDC_MIC_SOURCE, 240, 80, 126, 160, DROPDOWN_STYLE
    LTEXT           "Icons only appear while something is being recorded, streamed or buffered.", IDC_IND_HINT, 15, 99, 350, 17

    GROUPBOX        "Notifications", IDC_GRP_TOAST, 7, 126, 366, 76
    AUTOCHECKBOX    "Show &notifications", IDC_TOAST_SHOW, 15, 139, 180, 10
    RTEXT           "Position:", IDC_TOAST_CORNER_LABEL, 200, 140, 78, 8
    COMBOBOX        IDC_TOAST_CORNER, 282, 137, 84, 80, DROPDOWN_STYLE
    LTEXT           "Notify about:", IDC_TOAST_LABEL_ABOUT, 15, 156, 64, 8
    AUTOCHECKBOX    "Recording", IDC_N_REC, 82, 155, 62, 10
    AUTOCHECKBOX    "Streaming", IDC_N_STREAM, 146, 155, 54, 10
    AUTOCHECKBOX    "Replay buffer", IDC_N_REPLAY, 202, 155, 78, 10
    AUTOCHECKBOX    "Screenshots", IDC_N_SHOT, 282, 155, 84, 10
    AUTOCHECKBOX    "Virtual camera", IDC_N_VCAM, 82, 168, 118, 10
    AUTOCHECKBOX    "Microphone mute", IDC_N_MIC, 202, 168, 164, 10
    LTEXT           "Show for:", IDC_TOAST_LABEL_FOR, 15, 186, 64, 8
    EDITTEXT        IDC_TOAST_SECS, 82, 184, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_TOAST_SECS_SPIN, "msctls_updown32", UPDOWN_STYLE, 118, 184, 10, 12
    LTEXT           "seconds", IDC_TOAST_LABEL_SECS, 122, 186, 60, 8

    GROUPBOX        "Appearance", IDC_GRP_APPEARANCE, 7, 207, 366, 111
    LTEXT           "Display:", IDC_MONITOR_LABEL, 15, 222, 64, 8
    COMBOBOX        IDC_MONITOR, 82, 219, 284, 120, DROPDOWN_STYLE
    LTEXT           "Size:", IDC_SCALE_LABEL, 15, 239, 64, 8
    EDITTEXT        IDC_SCALE, 82, 237, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_SCALE_SPIN, "msctls_updown32", UPDOWN_STYLE, 118, 237, 10, 12
    LTEXT           "%", IDC_STATIC, 122, 239, 10, 8
    RTEXT           "Opacity:", IDC_OPACITY_LABEL, 134, 239, 64, 8
    EDITTEXT        IDC_OPACITY, 202, 237, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_OPACITY_SPIN, "msctls_updown32", UPDOWN_STYLE, 238, 237, 10, 12
    LTEXT           "%", IDC_STATIC, 242, 239, 10, 8
    RTEXT           "Margin:", IDC_MARGIN_LABEL, 254, 239, 50, 8
    EDITTEXT        IDC_MARGIN, 308, 237, 36, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_MARGIN_SPIN, "msctls_updown32", UPDOWN_STYLE, 344, 237, 10, 12
    LTEXT           "px", IDC_STATIC, 348, 239, 14, 8
    LTEXT           "Accent color:", IDC_ACCENT_LABEL, 15, 256, 64, 8
    LTEXT           "", IDC_ACCENT_SWATCH, 82, 254, 36, 12, WS_BORDER
    PUSHBUTTON      "&Choose...", IDC_ACCENT_PICK, 124, 253, 64, 14
    AUTOCHECKBOX    "&Hide the overlay from screen capture and recordings", IDC_HIDE_CAPTURE, 15, 272, 350, 10
    AUTOCHECKBOX    "Show the overlay over &fullscreen games (advanced)", IDC_SHOW_OVER_FULLSCREEN, 15, 286, 350, 10
    RTEXT           "Layer:", IDC_FS_BAND_LABEL, 28, 302, 40, 8
    COMBOBOX        IDC_FS_BAND, 72, 300, 294, 120, DROPDOWN_STYLE

    LTEXT           "Tip: bind ""Toggle overlay indicator"" in OBS Settings > Hotkeys.", IDC_HOTKEY_HINT, 10, 324, 360, 17

    PUSHBUTTON      "&Preview", IDC_PREVIEW, 7, 346, 70, 14
    DEFPUSHBUTTON   "OK", IDOK, 259, 346, 54, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 319, 346, 54, 14
END
VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLUGIN_VERSION_RC
 PRODUCTVERSION PLUGIN_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OBS Studio on-screen recording indicator"
            VALUE "FileVersion", PLUGIN_VERSION
            VALUE "ProductName", "obs-indicator"
            VALUE "ProductVersion", PLUGIN_VERSION
            VALUE "LegalCopyright", "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
